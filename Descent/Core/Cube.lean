import Descent.Core.Defect
import Mathlib.Algebra.Module.Defs
import Mathlib.Data.List.Perm.Basic
import Mathlib.Data.List.Sublists

/-!
# Comparison cubes

The pairwise defect measures failure of the valuation law on one comparison
square. The raw join calculus measures failure of factorization on comparison
cubes: over a base context `c`, directions `a₁, …, aₖ` span the `2 ^ k`
vertices `c ⊔ ⨆ᵢ∈ₛ aᵢ`, and the order-`k` mixed difference is the signed
alternating sum of `K` over them, with `+` on the top vertex.

`supDiff a` is the single difference operator `K ↦ K (· ⊔ a) - K ·` and
`mixedDiff l` iterates it over a finite list of directions, so the alternating
sum is the inclusion–exclusion theorem `mixedDiff_eq_sum_sublists'`, not the
definition. Everything up to the bridge consumes only `⊔` and works over a
`SemilatticeSup`; the meet enters only to choose a base point, and
`mixedDiff_pair_inf` identifies the order-2 mixed difference based at the meet
with the pairwise defect, up to the sign fixed in `Descent.Core.Defect`.
-/

namespace Descent

section SemilatticeSup

variable {R A : Type*} [SemilatticeSup R] [AddCommGroup A]

/-- The difference of `K` across the context change `· ⊔ a`: the failure of
`K` to be invariant when a description is refined by `a`. -/
def supDiff (a : R) (K : ContextField R A) : ContextField R A :=
  fun c => K (c ⊔ a) - K c

theorem supDiff_apply (a : R) (K : ContextField R A) (c : R) :
    supDiff a K c = K (c ⊔ a) - K c :=
  rfl

/-- A direction already contained in the base moves nothing. -/
theorem supDiff_apply_of_le (K : ContextField R A) {a c : R} (h : a ≤ c) :
    supDiff a K c = 0 := by
  rw [supDiff_apply, sup_of_le_left h, sub_self]

/-- The trivial direction is constant. -/
@[simp]
theorem supDiff_bot [OrderBot R] (K : ContextField R A) : supDiff ⊥ K = 0 := by
  funext c
  simp [supDiff_apply]

/-! ### Algebra in the field -/

@[simp]
theorem supDiff_zero (a : R) : supDiff a (0 : ContextField R A) = 0 := by
  funext c
  simp [supDiff_apply]

@[simp]
theorem supDiff_const (a : R) (c₀ : A) : supDiff a (ContextField.const R c₀) = 0 := by
  funext c
  simp [supDiff_apply]

theorem supDiff_add (a : R) (K K' : ContextField R A) :
    supDiff a (K + K') = supDiff a K + supDiff a K' := by
  funext c
  simp only [supDiff_apply, Pi.add_apply]
  abel

theorem supDiff_neg (a : R) (K : ContextField R A) : supDiff a (-K) = -supDiff a K := by
  funext c
  simp only [supDiff_apply, Pi.neg_apply]
  abel

theorem supDiff_sub (a : R) (K K' : ContextField R A) :
    supDiff a (K - K') = supDiff a K - supDiff a K' := by
  funext c
  simp only [supDiff_apply, Pi.sub_apply]
  abel

theorem supDiff_smul {S : Type*} [Monoid S] [DistribMulAction S A]
    (s : S) (a : R) (K : ContextField R A) :
    supDiff a (s • K) = s • supDiff a K := by
  funext c
  simp only [supDiff_apply, Pi.smul_apply, smul_sub]

/-! ### Commutation and collapse -/

/-- Difference operators commute: a cube does not order its directions. -/
theorem supDiff_comm (a b : R) (K : ContextField R A) :
    supDiff a (supDiff b K) = supDiff b (supDiff a K) := by
  funext c
  simp only [supDiff_apply]
  rw [sup_right_comm]
  abel

instance : LeftCommutative (supDiff (R := R) (A := A)) :=
  ⟨supDiff_comm⟩

/-- Iterated differences reduce to first-order ones through the join of the
directions. -/
theorem supDiff_supDiff (a b : R) (K : ContextField R A) :
    supDiff a (supDiff b K) = supDiff (a ⊔ b) K - supDiff a K - supDiff b K := by
  funext c
  simp only [supDiff_apply, Pi.sub_apply]
  rw [← sup_assoc]
  abel

/-- Comparable directions collapse the square: a coarser copy of a direction
only flips the sign. -/
theorem supDiff_supDiff_of_le {a b : R} (h : a ≤ b) (K : ContextField R A) :
    supDiff a (supDiff b K) = -supDiff a K := by
  funext c
  simp only [supDiff_apply, Pi.neg_apply]
  rw [sup_assoc, sup_of_le_right h]
  abel

/-- Repeating a direction only flips the sign: the hierarchy is generated by
incomparable directions. -/
theorem supDiff_supDiff_self (a : R) (K : ContextField R A) :
    supDiff a (supDiff a K) = -supDiff a K :=
  supDiff_supDiff_of_le le_rfl K

/-! ### Mixed differences -/

/-- The mixed difference of `K` along the directions in `l`: the iterated
difference operator over the comparison cube the directions span. -/
def mixedDiff (l : List R) (K : ContextField R A) : ContextField R A :=
  l.foldr supDiff K

@[simp]
theorem mixedDiff_nil (K : ContextField R A) : mixedDiff [] K = K :=
  rfl

@[simp]
theorem mixedDiff_cons (a : R) (l : List R) (K : ContextField R A) :
    mixedDiff (a :: l) K = supDiff a (mixedDiff l K) :=
  rfl

theorem mixedDiff_singleton (a : R) (K : ContextField R A) :
    mixedDiff [a] K = supDiff a K :=
  rfl

/-- Splitting the direction list splits the operator. -/
theorem mixedDiff_append (l₁ l₂ : List R) (K : ContextField R A) :
    mixedDiff (l₁ ++ l₂) K = mixedDiff l₁ (mixedDiff l₂ K) := by
  simp [mixedDiff, List.foldr_append]

/-- Permutation invariance: the mixed difference depends only on the multiset
of directions. -/
theorem mixedDiff_perm {l l' : List R} (h : l.Perm l') (K : ContextField R A) :
    mixedDiff l K = mixedDiff l' K :=
  h.foldr_eq K

@[simp]
theorem mixedDiff_zero (l : List R) : mixedDiff l (0 : ContextField R A) = 0 := by
  induction l with
  | nil => rfl
  | cons a l ih => simp only [mixedDiff_cons, ih, supDiff_zero]

theorem mixedDiff_add (l : List R) (K K' : ContextField R A) :
    mixedDiff l (K + K') = mixedDiff l K + mixedDiff l K' := by
  induction l with
  | nil => rfl
  | cons a l ih => simp only [mixedDiff_cons, ih, supDiff_add]

theorem mixedDiff_neg (l : List R) (K : ContextField R A) :
    mixedDiff l (-K) = -mixedDiff l K := by
  induction l with
  | nil => rfl
  | cons a l ih => simp only [mixedDiff_cons, ih, supDiff_neg]

theorem mixedDiff_sub (l : List R) (K K' : ContextField R A) :
    mixedDiff l (K - K') = mixedDiff l K - mixedDiff l K' := by
  induction l with
  | nil => rfl
  | cons a l ih => simp only [mixedDiff_cons, ih, supDiff_sub]

theorem mixedDiff_smul {S : Type*} [Monoid S] [DistribMulAction S A]
    (s : S) (l : List R) (K : ContextField R A) :
    mixedDiff l (s • K) = s • mixedDiff l K := by
  induction l with
  | nil => rfl
  | cons a l ih => simp only [mixedDiff_cons, ih, supDiff_smul]

/-! ### Degeneration -/

/-- Reduction under constant directions: a direction that moves `K` nowhere
kills every cube through it. -/
theorem mixedDiff_eq_zero_of_supDiff_eq_zero {a : R} {K : ContextField R A}
    (h : supDiff a K = 0) {l : List R} (ha : a ∈ l) : mixedDiff l K = 0 := by
  obtain ⟨s, t, rfl⟩ := List.append_of_mem ha
  have hp : (s ++ a :: t).Perm (s ++ t ++ [a]) :=
    List.perm_middle.trans (List.perm_append_singleton a (s ++ t)).symm
  rw [mixedDiff_perm hp K, mixedDiff_append, mixedDiff_singleton, h, mixedDiff_zero]

/-- A direction already contained in the base collapses the cube there. -/
theorem mixedDiff_apply_eq_zero_of_le {a c : R} {l : List R} (ha : a ∈ l)
    (hc : a ≤ c) (K : ContextField R A) : mixedDiff l K c = 0 := by
  obtain ⟨s, t, rfl⟩ := List.append_of_mem ha
  rw [mixedDiff_perm List.perm_middle K, mixedDiff_cons]
  exact supDiff_apply_of_le _ hc

/-- Two comparable directions collapse the cube one order, up to sign. -/
theorem mixedDiff_cons_cons_of_le {a b : R} (h : a ≤ b) (l : List R)
    (K : ContextField R A) :
    mixedDiff (a :: b :: l) K = -mixedDiff (a :: l) K :=
  supDiff_supDiff_of_le h (mixedDiff l K)

/-! ### Naturality -/

theorem supDiff_comp {R' : Type*} [SemilatticeSup R'] (f : SupHom R R')
    (K : ContextField R' A) (a : R) :
    supDiff a (K ∘ f) = supDiff (f a) K ∘ f := by
  funext c
  simp [supDiff_apply, map_sup]

/-- The cube is a property of the spanned directions, not of their labels. -/
theorem mixedDiff_comp {R' : Type*} [SemilatticeSup R'] (f : SupHom R R')
    (K : ContextField R' A) (l : List R) :
    mixedDiff l (K ∘ f) = mixedDiff (l.map f) K ∘ f := by
  induction l with
  | nil => rfl
  | cons a l ih => rw [mixedDiff_cons, ih, supDiff_comp, List.map_cons, mixedDiff_cons]

/-! ### Inclusion–exclusion -/

private theorem foldr_sup_sup (t : List R) (a c : R) :
    t.foldr (· ⊔ ·) (c ⊔ a) = a ⊔ t.foldr (· ⊔ ·) c := by
  induction t with
  | nil => exact sup_comm c a
  | cons x t ih => rw [List.foldr_cons, List.foldr_cons, ih, sup_left_comm]

private theorem sum_map_neg {ι : Type*} (l : List ι) (f : ι → A) :
    (l.map fun t => -f t).sum = -(l.map f).sum := by
  induction l with
  | nil => simp
  | cons x l ih =>
    rw [List.map_cons, List.sum_cons, List.map_cons, List.sum_cons, ih, neg_add]

/-- Inclusion–exclusion: the mixed difference is the signed alternating sum of
`K` over the `2 ^ l.length` vertices of the comparison cube, the vertex of a
sublist `t` being the join of `t` over the base. The top vertex carries `+`. -/
theorem mixedDiff_eq_sum_sublists' (l : List R) (K : ContextField R A) (c : R) :
    mixedDiff l K c
      = (l.sublists'.map fun t =>
          ((-1 : ℤ) ^ (l.length + t.length)) • K (t.foldr (· ⊔ ·) c)).sum := by
  induction l generalizing c with
  | nil => simp
  | cons a l ih =>
    have key₁ :
        (fun t : List R =>
            ((-1 : ℤ) ^ ((a :: l).length + t.length)) • K (t.foldr (· ⊔ ·) c))
          = fun t : List R =>
            -(((-1 : ℤ) ^ (l.length + t.length)) • K (t.foldr (· ⊔ ·) c)) := by
      funext t
      rw [List.length_cons, add_right_comm, pow_succ, mul_zsmul, neg_one_zsmul, zsmul_neg]
    have key₂ :
        ((fun t : List R =>
            ((-1 : ℤ) ^ ((a :: l).length + t.length)) • K (t.foldr (· ⊔ ·) c))
          ∘ List.cons a)
          = fun t : List R =>
            ((-1 : ℤ) ^ (l.length + t.length)) • K (t.foldr (· ⊔ ·) (c ⊔ a)) := by
      funext t
      simp only [Function.comp_apply, List.length_cons, List.foldr_cons, foldr_sup_sup]
      rw [show l.length + 1 + (t.length + 1) = l.length + t.length + 2 by omega,
        pow_add, neg_one_sq, mul_one]
    rw [mixedDiff_cons, supDiff_apply, ih, ih, List.sublists'_cons, List.map_append,
      List.sum_append, List.map_map, key₂, key₁, sum_map_neg]
    abel

/-! ### Low order -/

theorem mixedDiff_pair_apply (a b : R) (K : ContextField R A) (c : R) :
    mixedDiff [a, b] K c = K (c ⊔ a ⊔ b) - K (c ⊔ a) - K (c ⊔ b) + K c := by
  simp only [mixedDiff_cons, mixedDiff_nil, supDiff_apply]
  abel

end SemilatticeSup

/-! ### The bridge to the pairwise defect -/

section Lattice

variable {R A : Type*} [Lattice R] [AddCommGroup A]

/-- The exact law tying the order-2 mixed difference at an arbitrary base to
the pairwise defect of the translated pair; the discrepancy is the base-point
correction `K c - K ((c ⊔ a) ⊓ (c ⊔ b))`, which vanishes at the meet base. -/
theorem mixedDiff_pair_add_defect (K : ContextField R A) (a b c : R) :
    mixedDiff [a, b] K c + defect K (c ⊔ a) (c ⊔ b)
      = K c - K ((c ⊔ a) ⊓ (c ⊔ b)) := by
  rw [mixedDiff_pair_apply, defect_def, sup_sup_sup_comm, sup_idem, ← sup_assoc]
  abel

/-- The pairwise defect is the order-2 mixed difference based at the meet,
with the sign fixed in `Descent.Core.Defect`. -/
theorem mixedDiff_pair_inf (K : ContextField R A) (a b : R) :
    mixedDiff [a, b] K (a ⊓ b) = -defect K a b := by
  rw [mixedDiff_pair_apply, defect_def,
    show a ⊓ b ⊔ a = a by rw [sup_comm, sup_inf_self],
    show a ⊓ b ⊔ b = b by rw [sup_comm, inf_comm, sup_inf_self]]
  abel

end Lattice

end Descent
